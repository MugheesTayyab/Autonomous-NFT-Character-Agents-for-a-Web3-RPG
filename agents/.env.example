# Backend Action API Endpoint (from Phase 2)
BACKEND_API_URL=http://127.0.0.1:3001

# LLM Provider Configuration
# Optional: If OPENAI_API_KEY is not provided, agents operate using calibrated deterministic heuristics for testing
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.2

# Simulation Settings
HEARTBEAT_INTERVAL_MS=15000
AUTO_HEARTBEAT=true
LOG_LEVEL=info
